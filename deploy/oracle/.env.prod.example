# Reference only: setup.sh writes the real .env.prod on the server (random secrets, chmod 600). Never commit it.
DB_PASSWORD=<setup.sh: random>
JWT_SECRET=<setup.sh: random, 48 bytes base64>
S3_ACCESS_KEY=<setup.sh: random>
S3_SECRET_KEY=<setup.sh: random>
# Password of the fictional seed logins (dev@ ...). Random, so only the read-only demo login is usable.
DEV_SEED_PASSWORD=<setup.sh: random>
# From ~/.cloudflared/tunnel.json (the existing tunnel's credentials, copied from the Mac)
TUNNEL_ID=<setup.sh: TunnelID in tunnel.json>
TUNNEL_CREDENTIALS=/home/ubuntu/.cloudflared/tunnel.json
# Owner of tunnel.json; the cloudflared container runs as this uid to read it
HOST_UID=<setup.sh: id -u>
APP_BASE_URL=https://permit.rema.sarl
API_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseSerialGC
# Optional free 법제처 OC key; empty = law search answers 503, the rest works
LAW_API_OC=
# Not set on purpose: ANTHROPIC/GEMINI/OPENAI keys (AI extraction is blocked at the tunnel),
# GOOGLE_OAUTH_* (calendar sync off), SMTP_* (mail only logged).

# 선택: 테스터 회사 AI 추출용 Anthropic 키. 비우면 AI 추출이 동작하지 않는다(회사별 AI 스위치도 켜야 함).
ANTHROPIC_API_KEY=
