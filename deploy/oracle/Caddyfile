# Static frontend + /api proxy (the job vite's dev proxy does locally).
:80 {
	encode gzip
	handle /api/* {
		reverse_proxy api:8080
	}
	# partner share links: the page is the SPA, its data (JSON, .ics) comes from the API
	@shareData {
		path /share/*
		not header Accept *text/html*
	}
	handle @shareData {
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
