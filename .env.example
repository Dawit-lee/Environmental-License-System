# Copy to .env and fill in. .env is gitignored.
DB_USERNAME=envpermit
DB_PASSWORD=change-me
# At least 32 bytes, e.g. output of: openssl rand -base64 48
JWT_SECRET=
# dev = also seeds fictional sample data and dev logins (dev@envpermit.local, kim@, other@ ...)
SPRING_PROFILES_ACTIVE=dev
# Password of the dev seed logins. Unset = dev1234! (solo local only). Set it for any shared or public run (README).
# DEV_SEED_PASSWORD=
# Public demo only: true seeds the read-only demo@envpermit.local / demo1234! login (dev profile).
# DEMO_USER_ENABLED=
# Document storage (S3-compatible). docker compose runs SeaweedFS S3 with these as its admin login.
# Running the API outside docker: S3_ENDPOINT=http://localhost:8333. On AWS: leave S3_ENDPOINT empty.
S3_ACCESS_KEY=envpermit
S3_SECRET_KEY=change-me-too
S3_BUCKET=envpermit-documents
# 법제처 Open API (law.go.kr/DRF) OC key. Optional: without it only 법제처 search is unavailable.
LAW_API_OC=
# AI obligation extraction (optional; companies must also opt in). Keys are read only from these env vars.
# EXTRACTION_PROVIDER=claude|gemini|openai; empty = first with a key set (Claude, Gemini, OpenAI). See README.
EXTRACTION_PROVIDER=
ANTHROPIC_API_KEY=
# Free-tier Gemini keys may let Google use inputs to improve its products: real company documents only on a paid tier.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Mail (optional). SMTP_HOST empty = mail is only logged. Gmail: 2-step verification on → App passwords (README).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Web app address used in mail links
APP_BASE_URL=http://localhost:5182
# Google calendar one-way sync (optional; companies must also allow it). Any empty = feature off.
# OAuth client (Web application) redirect URI: APP_BASE_URL + /api/me/google-calendar/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh-token encryption key: output of: openssl rand -base64 32
GOOGLE_TOKEN_ENC_KEY=

# JVM options for the api container (default: -Xms128m -Xmx512m -XX:+UseSerialGC). Raise -Xmx if large PDF previews fail.
API_JAVA_OPTS=
