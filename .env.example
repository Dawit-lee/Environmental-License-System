# Copy to .env and fill in. .env is gitignored.
DB_USERNAME=envpermit
DB_PASSWORD=change-me
# At least 32 bytes, e.g. output of: openssl rand -base64 48
JWT_SECRET=
# dev = also seeds the local dev user (dev@envpermit.local / dev1234!)
SPRING_PROFILES_ACTIVE=dev
# Document storage (S3-compatible). docker compose runs SeaweedFS S3 with these as its admin login.
# Running the API outside docker: S3_ENDPOINT=http://localhost:8333. On AWS: leave S3_ENDPOINT empty.
S3_ACCESS_KEY=envpermit
S3_SECRET_KEY=change-me-too
S3_BUCKET=envpermit-documents
# 법제처 Open API (law.go.kr/DRF) OC key. Optional: without it only 법제처 search is unavailable.
LAW_API_OC=
# AI obligation extraction (optional; companies must also opt in). Keys are read only from these env vars.
# EXTRACTION_PROVIDER=claude|gemini|openai; empty = first with a key set (Claude, Gemini, OpenAI). See README.
EXTRACTION_PROVIDER=
ANTHROPIC_API_KEY=
# Free-tier Gemini keys may let Google use inputs to improve its products: real company documents only on a paid tier.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Mail (optional). SMTP_HOST empty = mail is only logged. Gmail: 2-step verification on → App passwords (README).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Web app address used in mail links
APP_BASE_URL=http://localhost:5182
