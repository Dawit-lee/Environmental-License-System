# Copy to .env and fill in. .env is gitignored.
DB_USERNAME=envpermit
DB_PASSWORD=change-me
# At least 32 bytes, e.g. output of: openssl rand -base64 48
JWT_SECRET=
# dev = also seeds the local dev user (dev@envpermit.local / dev1234!)
SPRING_PROFILES_ACTIVE=dev
# Document storage (S3-compatible). docker compose runs SeaweedFS S3 with these as its admin login.
# Running the API outside docker: S3_ENDPOINT=http://localhost:8333. On AWS: leave S3_ENDPOINT empty.
S3_ACCESS_KEY=envpermit
S3_SECRET_KEY=change-me-too
S3_BUCKET=envpermit-documents
# 법제처 Open API (law.go.kr/DRF) OC key. Optional: without it only 법제처 search is unavailable.
LAW_API_OC=
# Anthropic API key for AI obligation extraction. Optional; read only from this env var. Companies must also opt in.
ANTHROPIC_API_KEY=
